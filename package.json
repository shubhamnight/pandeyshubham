{
  "name": "shub-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node checks/run-regressions.cjs",
    "test:regression": "node checks/run-regressions.cjs",
    "test:regression:core": "node checks/run-regressions.cjs --group=core",
    "test:regression:list": "node checks/run-regressions.cjs --list",
    "test:backend": "node checks/backend-stress.cjs",
    "start": "npm run start --workspace @shub/media-studio",
    "build": "npm run build --workspace @shub/portfolio",
    "build:seo": "node apps/portfolio/compose.cjs && node build-site-assets.cjs && node build-seo.cjs",
    "build:mobile-media": "node build-mobile-media.cjs && node build-mobile-previews.cjs",
    "typecheck": "tsc --noEmit",
    "check": "node check-site.cjs",
    "check:media": "node check-media.cjs",
    "check:models": "node check-model-batching.mjs",
    "check:rounded-box": "node check-rounded-box.mjs",
    "check:loading-recovery": "node check-loading-recovery.mjs",
    "check:renderer": "node check-renderer-initialization.mjs",
    "check:desktop-performance": "node check-desktop-performance.cjs",
    "check:animation-performance": "node check-animation-performance.mjs",
    "build:photography": "node build-photography-carousel.cjs && node build-shared-ui.cjs",
    "build:connect": "node build-connect.cjs && node build-shared-ui.cjs",
    "build:gaming": "node build-gaming-overlay.cjs && node build-shared-ui.cjs",
    "build:travel-overlay": "node build-travel-overlay.cjs && node build-shared-ui.cjs",
    "build:music-overlay": "node build-music-overlay.cjs && node build-shared-ui.cjs",
    "build:skills": "node build-skills-icons.cjs && node build-shared-ui.cjs",
    "build:offline": "node build-offline.cjs",
    "enhance:photography": "node enhance-photography-ai.cjs",
    "enhance:photography-crops": "node enhance-photography-crops.cjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.0",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
